# dh-support-assistant environment overrides.
#
# Copy to .env to use with docker compose. `.env` is gitignored;
# `.env.example` is tracked (see .gitignore).
#
# Every DH_-prefixed variable overrides the matching key in config.yaml
# via the loader in internal/config/config.go.

# Postgres connection string used by the app container and the ingest CLI.
# Hostname `postgres` resolves on support-net to the compose service; outside
# Docker, point at a reachable database or leave unset to keep readiness
# reporting {"status":"no_db"}.
DH_DB_URL=postgres://dh:dh@postgres:5432/dh?sslmode=disable

# HTTP listen address for the API server. ":PORT" binds all interfaces.
DH_LISTEN_ADDR=:8080

# Zerolog level: trace | debug | info | warn | error | fatal | panic | disabled.
DH_LOG_LEVEL=info
