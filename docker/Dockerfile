# dh-support-assistant `app` image.
#
# Stage 1 compiles cmd/server and cmd/ingest with CGO off so the binaries are
# static and run on the alpine:latest runtime without any glibc shim.
#
# WHY -mod=vendor: the build container cannot reach proxy.golang.org because
# the corporate WSL network intercepts TLS with a CA the alpine cert bundle
# does not trust. The repo's vendor/ directory (regenerated by Make targets
# from the host's module cache) keeps the build fully offline.
#
# WHY no `apk add` in the runtime stage: the same TLS interception breaks
# `apk add` against dl-cdn.alpinelinux.org. We don't need ca-certificates
# (zero-egress stack — no outbound TLS) or tzdata (no time.LoadLocation),
# so the runtime stays at the bare alpine:latest base. busybox supplies sh
# and nslookup, which is everything the entrypoint smoke test needs.

FROM golang:1.26-alpine@sha256:f85330846cde1e57ca9ec309382da3b8e6ae3ab943d2739500e08c86393a21b1 AS build
WORKDIR /src

COPY . .

ENV CGO_ENABLED=0
RUN go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/server ./cmd/server \
 && go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest

FROM alpine:latest@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11

# Entrypoint wrapper enforces [Rule: Zero egress] at container start.
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

COPY --from=build /out/server /usr/local/bin/server
COPY --from=build /out/ingest /usr/local/bin/ingest

# /app/logs is bind-mounted by docker compose so logs survive container
# restarts. Pre-create with ownership so the unprivileged user can write.
RUN mkdir -p /app/logs && chown -R 65534:65534 /app
WORKDIR /app
USER 65534:65534

# Marker env read by internal/net/egress_test.go so container-only tests
# execute inside the stack and skip on the dev host.
ENV DH_IN_SUPPORT_NET=1
ENV DH_LOG_PATH=/app/logs/app.log

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/server"]
